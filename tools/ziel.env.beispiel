# Vorlage. Kopieren nach tools/ziel.env und anpassen -- die Kopie liegt nicht im
# Repo, weil sie den Namen des eigenen Servers nennt.

# Wohin uebertragen wird, im Format benutzer@rechner. Der Rechnername ist der
# Tailscale-Name des Pi.
ZIEL=benutzer@rechner

# Unter welchem Pfad die App auf dem Server erreichbar ist. Muss zum Block in
# der Caddyfile passen und wandert beim Bauen als BASE_PATH in die App.
BASIS=/hub/

# Optional: weitere Links in der Seitenleiste, etwa zu anderen Apps auf dem
# Server. Eintraege mit ; trennen, je Name|Ziel|Icon. Das Icon ist optional
# (z. B. server, clock, box, user); ohne LINKS gibt es den Abschnitt nicht.
# LINKS=Startseite|/|server; Andere App|/andere-app/
